# auto: 接続情報なしならサンプル、両方設定済みならmicroCMS。
# sample: 接続情報を両方設定したままでもサンプルを表示。
# microcms: 接続情報が未設定ならビルドを失敗させる。本番公開時に推奨。
DATA_SOURCE=auto

# microCMSに接続するときは、以下の2項目を両方設定してください。
# サービスIDのみを入力（例: my-picks）。https:// や .microcms.io は不要です。
# APIキーには things / brands / categories のGET権限を付けてください。
# thingsの公開状態確認用にマネジメントAPIの「コンテンツの取得 (一覧・詳細)」権限も必要です。
# 3 APIのデータが空の場合は空コレクションになり、サンプルへ自動切り替えしません。
MICROCMS_SERVICE_DOMAIN=
MICROCMS_API_KEY=

# canonicalとOGPの公開URL。未設定時もhttps://iamkaz.unoを使用します。
SITE_URL=https://iamkaz.uno
