---
import type { GetStaticPaths } from 'astro';
import type { Thing, Content } from '../../../types/content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import ThingImage from '../../../components/ThingImage.astro';
import { getContent } from '../../../lib/content';
import { collectionPath } from '../../../lib/paths';

export const getStaticPaths = (async () => {
  const content = await getContent();
  return content.things.map((thing) => ({
    params: { id: thing.id },
    props: { thing, source: content.source },
  }));
}) satisfies GetStaticPaths;

interface Props { thing: Thing; source: Content['source'] }
const { thing, source } = Astro.props;
const sample = source === 'sample';
const preconnectImageCdn = thing.image?.url.startsWith('https://images.microcms-assets.io/') ?? false;
const description = `${thing.name}${thing.brand ? ` — ${thing.brand.name}` : ''}。/picksのコレクション。`;
---

<BaseLayout title={`${thing.name} — /picks`} description={description} noindex={sample} preconnectImageCdn={preconnectImageCdn}>
  <div class="site-shell site-shell--wide">
    <SiteHeader />
  </div>
  <main id="main" class="site-shell thing-detail">
    <div class="detail-topline">
      <a class="collection-back" href={collectionPath} data-back-to-picks data-astro-prefetch><span aria-hidden="true">←</span> Back to picks</a>
    </div>
    <article class="detail-grid" aria-labelledby="thing-title">
      <header class="detail-heading">
        {thing.brand && <p class="detail-brand">{thing.brand.name}</p>}
        <h1 id="thing-title">{thing.name}</h1>
      </header>
      <div class="detail-image-wrap"><ThingImage image={thing.image} name={thing.name} eager detail /></div>
      {(thing.descriptionHtml || thing.categories.length > 0) && (
        <div class="detail-copy">
          {thing.descriptionHtml && <div class="detail-description"><div class="rich-text" set:html={thing.descriptionHtml} /></div>}
          {thing.categories.length > 0 && <ul class="detail-categories" aria-label="カテゴリ">{thing.categories.map((category) => <li>{category.name}</li>)}</ul>}
        </div>
      )}
    </article>
  </main>
  <div class="site-shell site-shell--wide">
    <SiteFooter />
  </div>
</BaseLayout>

<script>
  import { prefetch } from 'astro:prefetch';
  import { initDetailNavigation } from '../../../scripts/picks-navigation';
  initDetailNavigation();
  // 復元先のカテゴリ付きURLが確定してから、その一覧だけを先読みする。
  const backLink = document.querySelector<HTMLAnchorElement>('[data-back-to-picks]');
  if (backLink) prefetch(backLink.href);
</script>
