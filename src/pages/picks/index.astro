---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ItemCard from '../../components/ItemCard.astro';
import { getContent } from '../../lib/content';

const { things, categories, source } = await getContent();
const sample = source === 'sample';
const count = (id: string) => things.filter((thing) => thing.categories.some((category) => category.id === id)).length;
// URIエンコードしたキーなら、空白を含むIDもCSSの属性トークンで安全に照合できる。
const categoryKeys = categories.map((category) => encodeURIComponent(category.id));
---

<BaseLayout noindex={sample}>
  <div class="site-shell">
    <SiteHeader />

    <main id="main">
      <script define:vars={{ categoryKeys }} data-filter-prepare>
        (() => {
          const key = encodeURIComponent(new URLSearchParams(window.location.search).get('category') || '');
          if (!key || !categoryKeys.includes(key)) return;
          // カードがHTMLから読み込まれる前に非対象を隠す。lazy画像の不要な取得も防ぐ。
          const style = document.createElement('style');
          style.id = 'picks-initial-filter';
          style.textContent = `[data-item]:not([data-category-keys~="${key}"]) { display: none !important; } [data-results-label] { visibility: hidden; }`;
          document.head.append(style);
        })();
      </script>
      <section class="collection" id="collection" aria-label="持ち物一覧">
        <div class="collection-toolbar">
          <div class="filter-navigation" hidden data-filter-navigation>
            <div class="filters" id="category-filters" role="group" aria-label="カテゴリで絞り込む" data-filters>
              <button type="button" class="filter-button" data-filter="" data-filter-label="all" aria-pressed="true">all<span>{things.length}</span></button>
              {categories.map((category) => (
                <button type="button" class="filter-button" data-filter={category.id} data-filter-label={category.name} aria-pressed="false">{category.name}<span>{count(category.id)}</span></button>
              ))}
            </div>
            <button type="button" class="filter-scroll-button filter-scroll-button--previous" aria-label="前のカテゴリを表示" aria-controls="category-filters" data-filter-scroll="previous" disabled>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m14 6-6 6 6 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </button>
            <button type="button" class="filter-scroll-button filter-scroll-button--next" aria-label="次のカテゴリを表示" aria-controls="category-filters" data-filter-scroll="next" disabled>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m10 6 6 6-6 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </button>
          </div>
          <noscript><p class="no-script-note">すべてのアイテムを表示しています。</p></noscript>
          <p class="results-label" role="status" aria-live="polite" aria-atomic="true" data-results-label><span data-result-count>{String(things.length).padStart(2, '0')}</span> things, well loved.</p>
        </div>

        <ul class="item-grid" data-item-grid>
          {things.map((thing, index) => <ItemCard thing={thing} index={index} />)}
        </ul>
        <div class="empty-state" data-empty-state hidden={things.length !== 0}>
          <span aria-hidden="true">↳</span>
          <p>まだ、ここには何もありません。</p>
          <p class="empty-state-note">お気に入りが見つかるまで、少しだけ。</p>
        </div>
        <script is:inline data-filter-apply>
          (() => {
            // 外部の操作用moduleを待たず、初回の絞り込み・件数・画像優先度を確定する。
            const buttons = Array.from(document.querySelectorAll('[data-filter]'));
            const requested = new URLSearchParams(window.location.search).get('category') || '';
            const selected = buttons.find((button) => button.dataset.filter === requested) || buttons[0];
            const category = selected?.dataset.filter || '';
            const key = encodeURIComponent(category);
            let visible = 0;
            for (const item of document.querySelectorAll('[data-item]')) {
              item.hidden = category !== '' && !item.dataset.categoryKeys.split(' ').includes(key);
              if (item.hidden) continue;
              if (visible++ < 4) {
                const image = item.querySelector('img');
                if (image) image.loading = 'eager';
              }
            }
            for (const button of buttons) button.setAttribute('aria-pressed', String(button === selected));
            const label = document.querySelector('[data-results-label]');
            if (label) label.textContent = category === ''
              ? `${String(visible).padStart(2, '0')} things, well loved.`
              : `${selected.dataset.filterLabel} — ${String(visible).padStart(2, '0')} things`;
            const empty = document.querySelector('[data-empty-state]');
            if (empty) empty.hidden = visible !== 0;
            document.getElementById('picks-initial-filter')?.remove();
          })();
        </script>
      </section>

    </main>

    <SiteFooter />
  </div>
</BaseLayout>

<script>
  import { initFilters } from '../../scripts/filters';
  import { initItemInteractions } from '../../scripts/item-interactions';
  import { initCollectionNavigation } from '../../scripts/picks-navigation';
  initFilters();
  initItemInteractions();
  initCollectionNavigation();
</script>
