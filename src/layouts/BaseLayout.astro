---
import '../styles/fonts.css';
import '../styles/global.css';
import ThemeInit from '../components/ThemeInit.astro';
import { canonicalUrl } from '../lib/paths';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  siteName?: string;
  image?: string | false;
  imageAlt?: string;
  preconnectImageCdn?: boolean;
  type?: 'website' | 'article';
  publishedAt?: string | null;
}

const {
  title = '/picks — Things I use and love.',
  description = 'Things I use and love.',
  noindex = false,
  siteName = '/picks',
  image = import.meta.env.PROD ? '/og-picks.jpg' : '/og-picks.png',
  imageAlt = '/picks — Things I use and love.',
  preconnectImageCdn = false,
  type = 'website',
  publishedAt,
} = Astro.props;
const canonical = canonicalUrl(Astro.url, Astro.site);
const shareImage = Astro.site && image ? new URL(image, Astro.site) : undefined;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {preconnectImageCdn && <link rel="preconnect" href="https://images.microcms-assets.io" />}
    <slot name="preload" />
    <meta name="description" content={description} />
    <ThemeInit />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content={type} />
    {type === 'article' && publishedAt && (
      <meta property="article:published_time" content={publishedAt} />
    )}
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="ja_JP" />
    {canonical && <meta property="og:url" content={canonical} />}
    {shareImage && <meta property="og:image" content={shareImage} />}
    {shareImage && <meta property="og:image:width" content="1200" />}
    {shareImage && <meta property="og:image:height" content="630" />}
    {shareImage && <meta property="og:image:alt" content={imageAlt} />}
    <meta name="twitter:card" content={shareImage ? 'summary_large_image' : 'summary'} />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <slot />
  </body>
</html>
