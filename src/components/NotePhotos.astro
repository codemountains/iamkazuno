---
import { getThingImageSources } from '../lib/thing-image';
import type { NotePhotoSection } from '../types/notes';

interface Props { section: NotePhotoSection }
const { title, photos } = Astro.props.section;
const multiple = photos.length > 1;
const sizes = '(max-width: 600px) calc(100vw - 48px), (max-width: 776px) calc(100vw - 96px), 680px';
---

<section class="note-photos" aria-label={title || '写真'}>
  {title && <h2>{title}</h2>}
  <div class="note-photos-track" id="note-photos-track" role="group" aria-label="写真一覧" tabindex={multiple ? 0 : undefined}>
    {photos.map((photo, index) => {
      const sources = getThingImageSources(photo, true);
      return (
        <picture>
          {sources && <source type="image/avif" srcset={sources.avifSrcset} sizes={sizes} />}
          <img
            src={sources?.src ?? photo.url}
            srcset={sources?.webpSrcset}
            sizes={sources ? sizes : undefined}
            width={photo.width}
            height={photo.height}
            alt={photo.alt || `${title || '写真'}（${index + 1}枚目）`}
            loading="lazy"
            decoding="async"
          />
        </picture>
      );
    })}
  </div>
  {multiple && (
    <div class="note-photos-controls" hidden>
      <span class="note-photos-count" aria-live="off" aria-atomic="true">1 / {photos.length}</span>
      <button type="button" class="note-photos-play" aria-label="自動再生を開始" aria-controls="note-photos-track">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path class="play-icon" d="m7.5 4.5 12 7.5-12 7.5z" />
          <path class="pause-icon" d="M6.5 5h3.5v14H6.5zm7.5 0h3.5v14H14z" />
        </svg>
      </button>
      <button type="button" class="note-photos-prev" aria-label="前の写真" aria-controls="note-photos-track">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m14.5 6-6 6 6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </button>
      <button type="button" class="note-photos-next" aria-label="次の写真" aria-controls="note-photos-track">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m9.5 6 6 6-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </button>
    </div>
  )}
</section>

<script>
  import { initNotePhotos } from '../scripts/note-photos';
  initNotePhotos();
</script>
