---
import { collectionSize } from '../lib/collection-size';
---

<div class="collection-size-control" data-size-control hidden>
  <svg class="size-icon size-icon--small" width="18" height="18" viewBox="0 0 18 18" fill="currentColor" aria-hidden="true">
    <path d="M2 2h3v3H2zM7.5 2h3v3h-3zM13 2h3v3h-3zM2 7.5h3v3H2zM7.5 7.5h3v3h-3zM13 7.5h3v3h-3zM2 13h3v3H2zM7.5 13h3v3h-3zM13 13h3v3h-3z" />
  </svg>
  <input
    class="size-range"
    type="range"
    aria-label="画像サイズ"
    min={collectionSize.min}
    max={collectionSize.max}
    step={collectionSize.step}
    value={collectionSize.initial}
    data-size-range
  />
  <svg class="size-icon size-icon--large" width="18" height="18" viewBox="0 0 18 18" fill="currentColor" aria-hidden="true">
    <path d="M2 2h6v6H2zM10 2h6v6h-6zM2 10h6v6H2zM10 10h6v6h-6z" />
  </svg>
</div>

<style>
  .collection-size-control {
    position: fixed;
    z-index: 20;
    left: 50%;
    bottom: max(18px, env(safe-area-inset-bottom));
    display: flex;
    align-items: center;
    gap: 14px;
    width: 220px;
    max-width: calc(100vw - 32px - env(safe-area-inset-left) - env(safe-area-inset-right));
    height: 48px;
    max-height: calc(100svh - 18px - env(safe-area-inset-top) - env(safe-area-inset-bottom));
    padding: 0 18px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    background: var(--paper);
    box-shadow: 0 4px 18px #0000000d;
    transform: translateX(-50%);
    transition: opacity 160ms ease, transform 160ms ease;
  }

  .collection-size-control[data-scroll-hidden] {
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, 6px);
  }

  .size-icon { flex: 0 0 18px; }

  .size-range {
    --size-progress: 37.5%;
    appearance: none;
    -webkit-appearance: none;
    flex: 1;
    min-width: 0;
    height: 44px;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    accent-color: var(--accent);
  }

  .size-range::-webkit-slider-runnable-track {
    height: 3px;
    border-radius: 99px;
    background: linear-gradient(to right, var(--accent) var(--size-progress), var(--line) var(--size-progress));
  }

  .size-range::-moz-range-track {
    height: 3px;
    border-radius: 99px;
    background: var(--line);
  }

  .size-range::-moz-range-progress {
    height: 3px;
    border-radius: 99px;
    background: var(--accent);
  }

  .size-range::-webkit-slider-thumb {
    appearance: none;
    -webkit-appearance: none;
    width: 14px;
    height: 14px;
    margin-top: -5.5px;
    border: 0;
    border-radius: 50%;
    background: var(--ink);
  }

  .size-range::-moz-range-thumb {
    width: 14px;
    height: 14px;
    border: 0;
    border-radius: 50%;
    background: var(--ink);
  }

  .size-range:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .collection-size-control { transition: none; }
  }
</style>
