---
import Wordmark from './Wordmark.astro';
import SettingsMenu from './SettingsMenu.astro';

interface Props {
  section?: 'picks' | 'notes';
  pageHeading?: boolean;
}
const { section = 'picks', pageHeading = false } = Astro.props;
---

<header id="top" class="site-header">
  <div class="site-identity">
    {pageHeading ? (
      <h1 class="site-title" aria-label={`/${section}`}>
        <Wordmark section={section} />
      </h1>
    ) : (
      <Wordmark section={section} />
    )}
    <p class="site-subtitle">
      {section === 'notes' ? 'Thoughts, put into words.' : 'Things I use and love.'}
    </p>
  </div>
  <SettingsMenu>
    <slot name="settings" />
  </SettingsMenu>
</header>

<style>
  .site-title {
    display: flex;
    margin: 0;
    font: inherit;
  }
</style>
