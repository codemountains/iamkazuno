---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import NoteDate from './NoteDate.astro';
import { notesDescription, notesTitle } from '../lib/notes';
import type { NotesPage } from '../lib/notes-pagination';
import type { NotesContent } from '../types/notes';
import { notePath, notesFeedPath, notesPagePath } from '../lib/paths';
import '../styles/notes.css';

interface Props {
  page: NotesPage;
  source: NotesContent['source'];
}
const { page, source } = Astro.props;
const { notes, currentPage, totalPages, totalNotes } = page;
---

<BaseLayout
  title={currentPage === 1 ? notesTitle : `Page ${currentPage} — /notes`}
  description={notesDescription}
  siteName="/notes"
  image="/og-notes.png"
  imageAlt={notesTitle}
  noindex={source === 'sample'}
>
  <link
    slot="head"
    rel="alternate"
    type="application/rss+xml"
    title={notesTitle}
    href={notesFeedPath}
  />

  <div class="site-shell site-shell--wide">
    <SiteHeader section="notes" />
  </div>

  <main id="main" class="notes-index">
    <header class="notes-intro">
      <p class="notes-eyebrow">
        <span aria-hidden="true">/</span> A PERSONAL NOTEBOOK
      </p>
      <h1>
        言葉にして、
        <br />
        残しておく。
      </h1>
    </header>

    <section class="notes-collection" aria-labelledby="notes-heading">
      <div class="notes-collection-heading">
        <h2 id="notes-heading">
          All notes
          <span class="notes-count" aria-label={`${totalNotes}件`}>
            {String(totalNotes).padStart(3, '0')}
          </span>
        </h2>
        <a
          class="notes-rss-link"
          href={notesFeedPath}
          type="application/rss+xml"
          aria-label="RSSフィードを開く"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="5" cy="19" r="2" fill="currentColor" />
            <path
              d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            />
          </svg>
          RSS
        </a>
      </div>
      {notes.length > 0 ? (
        <ol class="note-list">
          {notes.map((note) => (
            <li>
              <article>
                <a
                  class="note-entry"
                  href={notePath(note.id)}
                  data-astro-prefetch
                  aria-labelledby={`note-${note.id}`}
                >
                  <div class="note-entry-date">
                    <NoteDate date={note.publishedAt} />
                  </div>
                  <div>
                    <h2 id={`note-${note.id}`}>{note.title}</h2>
                    {note.excerpt && <p class="note-excerpt">{note.excerpt}</p>}
                  </div>
                </a>
              </article>
            </li>
          ))}
        </ol>
      ) : (
        <div class="notes-empty">
          <p>まだ、白紙。</p>
          <p>言葉になったら、ここに。</p>
        </div>
      )}
      {totalPages > 1 && (
        <nav class="notes-page-links" aria-label="ノート一覧のページ送り">
          {currentPage > 1 && (
            <a rel="prev" href={notesPagePath(currentPage - 1)} data-astro-prefetch>
              <span aria-hidden="true">←</span> Previous
            </a>
          )}
          <span class="notes-page-count" aria-current="page">
            Page {currentPage} / {totalPages}
          </span>
          {currentPage < totalPages && (
            <a rel="next" href={notesPagePath(currentPage + 1)} data-astro-prefetch>
              Next <span aria-hidden="true">→</span>
            </a>
          )}
        </nav>
      )}
    </section>
  </main>

  <div class="site-shell site-shell--wide">
    <SiteFooter section="notes" />
  </div>
</BaseLayout>
