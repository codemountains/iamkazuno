---
import ThemePicker from './ThemePicker.astro';
---

<div class="display-settings" data-settings hidden>
  <button
    type="button"
    class="settings-toggle"
    aria-label="表示設定"
    title="表示設定"
    aria-expanded="false"
    aria-controls="display-settings-panel"
    data-settings-toggle
  >
    <svg
      width="22"
      height="22"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <path d="M3 7h3m5 0h10M3 17h10m5 0h3" />
      <circle cx="8.5" cy="7" r="2.5" />
      <circle cx="15.5" cy="17" r="2.5" />
    </svg>
  </button>
  <div
    id="display-settings-panel"
    class="settings-panel frosted-panel"
    role="group"
    aria-label="表示設定"
    data-settings-panel
    hidden
  >
    <ThemePicker />
    <slot />
  </div>
</div>

<script>
  const settings = document.querySelector<HTMLElement>('[data-settings]');
  const toggle = settings?.querySelector<HTMLButtonElement>('[data-settings-toggle]');
  const panel = settings?.querySelector<HTMLElement>('[data-settings-panel]');

  if (settings && toggle && panel) {
    const setOpen = (open: boolean) => {
      panel.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
    };

    toggle.addEventListener('click', () => {
      setOpen(panel.hasAttribute('hidden'));
      toggle.focus({ preventScroll: true });
    });

    const closeFromOutside = (event: Event) => {
      if (!panel.hidden && event.target instanceof Node && !settings.contains(event.target)) {
        setOpen(false);
      }
    };
    document.addEventListener('click', closeFromOutside);
    document.addEventListener('focusin', closeFromOutside);
    document.addEventListener('keydown', (event) => {
      if (!panel.hidden && event.key === 'Escape') {
        event.preventDefault();
        setOpen(false);
        toggle.focus({ preventScroll: true });
      }
    });
    window.addEventListener('pagehide', () => setOpen(false));
    settings.hidden = false;
  }
</script>

<style>
  .display-settings {
    position: absolute;
    top: max(16px, env(safe-area-inset-top));
    right: max(16px, env(safe-area-inset-right));
    z-index: 8;
  }

  .settings-toggle {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 50%;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }

  .settings-toggle:active,
  .settings-toggle[aria-expanded='true'] {
    border-color: var(--line);
    background: var(--soft);
  }

  .settings-toggle[aria-expanded='true'] {
    color: var(--accent);
  }

  @media (hover: hover) {
    .settings-toggle:hover {
      border-color: var(--line);
      background: var(--soft);
    }
  }

  .settings-panel {
    --frosted-panel-opacity: 92%;
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    display: grid;
    gap: 8px;
    width: 236px;
    max-width: calc(100vw - 48px);
    max-height: calc(100svh - 100px - env(safe-area-inset-bottom));
    overflow-y: auto;
    padding: 12px 16px;
    border-radius: 16px;
    font-size: var(--font-size-label);
    line-height: 1.5;
  }
</style>
