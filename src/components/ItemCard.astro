---
import type { Thing } from '../types/content';
import ThingImage from './ThingImage.astro';
import { thingPath } from '../lib/paths';

interface Props { thing: Thing; index: number }
const { thing, index } = Astro.props;
---

<li class="item" data-item data-categories={JSON.stringify(thing.categories.map((category) => category.id))}>
  <article class="item-card" aria-labelledby={`item-${thing.id}`}>
    <a class="item-card-link" href={thingPath(thing.id)} aria-labelledby={`item-${thing.id}`}>
      <div class="item-image-wrap">
        <span class="item-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
        <ThingImage image={thing.image} name={thing.name} eager={index < 4} />
        {thing.categories.length > 0 && <span class="item-category">{thing.categories.map((category) => category.name).join(' / ')}</span>}
      </div>
      <div class="item-copy">
        {thing.brand && <p class="item-brand">{thing.brand.name}</p>}
        <h2 id={`item-${thing.id}`}>{thing.name}</h2>
      </div>
    </a>
  </article>
</li>
