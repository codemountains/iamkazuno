---
import type { PickImage } from '../types/content';
import { getThingImageSources } from '../lib/thing-image';

interface Props {
  image: PickImage | null;
  name: string;
  eager?: boolean;
  detail?: boolean;
  deferred?: boolean;
}
const { image, name, eager = false, detail = false, deferred = false } = Astro.props;
const sources = image ? getThingImageSources(image, detail) : null;
// 一覧は画像の有効化前とサイズ変更時にJSで実幅を渡し、no-JS時はautoを使う。
// 詳細は画像枠からimg自身の左右padding（18pxずつ）を除いた描画幅。
const sizes = detail
  ? '(max-width: 600px) calc(100vw - 84px), (max-width: 760px) calc(100vw - 100px), (max-width: 850px) calc((100vw - 176px) / 2), (max-width: 896px) calc((100vw - 208px) / 2), (max-width: 1100px) 344px, 328px'
  : 'auto, 160px';
const imageAttributes = {
  class: `item-image${detail ? ' detail-image' : ''}`,
  sizes,
  width: image?.width,
  height: image?.height,
  alt: image?.alt || name,
  loading: eager ? 'eager' : 'lazy',
  fetchpriority: detail && eager ? 'high' : undefined,
  decoding: 'async',
} as const;
---
{image ? (
  deferred ? (
    <picture class="thing-picture" data-deferred-picture>
      {sources && <source type="image/avif" data-image-srcset={sources.avifSrcset} sizes={sizes} />}
      <img
        {...imageAttributes}
        data-collection-image
        src="data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs="
        data-image-src={sources?.src ?? image.url}
        data-image-srcset={sources?.webpSrcset}
      />
    </picture>
    <noscript>
      <style is:inline>[data-deferred-picture] { display: none !important; }</style>
      <picture class="thing-picture">
        {sources && <source type="image/avif" srcset={sources.avifSrcset} sizes={sizes} />}
        <img {...imageAttributes} src={sources?.src ?? image.url} srcset={sources?.webpSrcset} />
      </picture>
    </noscript>
  ) : sources ? (
    <picture class="thing-picture">
      <source type="image/avif" srcset={sources.avifSrcset} sizes={sizes} />
      <img {...imageAttributes} src={sources.src} srcset={sources.webpSrcset} />
    </picture>
  ) : <img {...imageAttributes} src={image.url} />
) : (
  <div class="image-placeholder" role="img" aria-label={`${name}の画像は未登録です`}>
    <svg width="40" height="40" viewBox="0 0 40 40" fill="none" aria-hidden="true"><rect x="5" y="6" width="30" height="28" rx="3" stroke="currentColor" stroke-width="1.2" /><circle cx="14" cy="15" r="3" stroke="currentColor" stroke-width="1.2" /><path d="m6 29 9-9 7 7 5-5 8 8" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" /></svg>
    <span>No image yet</span>
  </div>
)}
