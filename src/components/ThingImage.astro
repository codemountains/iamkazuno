---
import type { PickImage } from '../types/content';

interface Props {
  image: PickImage | null;
  name: string;
  eager?: boolean;
  detail?: boolean;
}
const { image, name, eager = false, detail = false } = Astro.props;
const isMicroCMSImage = (() => {
  try { return image && new URL(image.url).hostname === 'images.microcms-assets.io'; }
  catch { return false; }
})();
function imageAt(width: number) {
  const url = new URL(image!.url);
  url.searchParams.set('w', String(width));
  url.searchParams.set('fm', 'webp');
  url.searchParams.set('q', '85');
  return url.href;
}
const src = image ? (isMicroCMSImage ? imageAt(detail ? 960 : 640) : image.url) : undefined;
const srcset = isMicroCMSImage
  ? (detail ? [480, 640, 960, 1280] : [320, 480, 640, 960]).map((width) => `${imageAt(width)} ${width}w`).join(', ')
  : undefined;
// 一覧は (コンテナ幅 - 列間の余白合計) / 列数。最大幅は (800 - 24 * 3) / 4 = 182px。
// 詳細は760px以下が1列、それ以外は2列。800px上限に達する画面幅は800 + 96 = 896px。
const sizes = detail
  ? '(max-width: 600px) calc(100vw - 48px), (max-width: 760px) calc(100vw - 64px), (max-width: 850px) calc((100vw - 104px) / 2), (max-width: 896px) calc((100vw - 136px) / 2), (max-width: 1100px) 380px, 364px'
  : '(max-width: 600px) calc((100vw - 64px) / 2), (max-width: 850px) calc((100vw - 104px) / 3), (max-width: 896px) calc((100vw - 168px) / 4), 182px';
---
{image ? (
  <img
    class:list={['item-image', { 'detail-image': detail }]}
    src={src}
    srcset={srcset}
    sizes={sizes}
    width={image.width}
    height={image.height}
    alt={image.alt || name}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
  />
) : (
  <div class="image-placeholder" role="img" aria-label={`${name}の画像は未登録です`}>
    <svg width="40" height="40" viewBox="0 0 40 40" fill="none" aria-hidden="true"><rect x="5" y="6" width="30" height="28" rx="3" stroke="currentColor" stroke-width="1.2" /><circle cx="14" cy="15" r="3" stroke="currentColor" stroke-width="1.2" /><path d="m6 29 9-9 7 7 5-5 8 8" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" /></svg>
    <span>No image yet</span>
  </div>
)}
