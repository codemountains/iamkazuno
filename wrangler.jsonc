{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "picks",
  "compatibility_date": "2026-11-10",
  "routes": [
    { "pattern": "iamkaz.uno", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  }
}
